load("R_data/Ptprc_or_Itgam_0/final/decontx_clustering_res.0.6.RData")
B.cell <- subset(reassign, idents = "B cells") # n = 639
DimPlot(B.cell, reduction = "umap", label = TRUE, pt.size = 0.2, alpha = 0.5)

# Single-cell-level DEG analysis using Seurat (based on the non-parametric Wilcoxon rank sum test)
Idents(B.cell) <- "sample_name"

d6 <- FindMarkers(B.cell, ident.1 = "CD45+ brain 1000pfu intranasal 6d", 
                  ident.2 = "CD45+ brain mock 0d", verbose = FALSE)
deg6_1 <- d6 %>% filter(avg_log2FC >= 1, p_val_adj <= 0.01, pct.1 > 0.2)
deg6_2 <- d6 %>% filter(avg_log2FC <= -1, p_val_adj <= 0.01, pct.2 > 0.2)
deg6 <- rbind(deg6_1, deg6_2)
write.csv(deg6, "R_data/Ptprc_or_Itgam_0/final/B.cells/6_seurat.csv")

