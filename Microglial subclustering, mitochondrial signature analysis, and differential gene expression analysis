# Compare transcriptional dysregulation across subclusters
subclusters <- unique(SCT$reassigned_clusters)
# For each subcluster: aggregate expression by dpi, run PCA, compute distance from dpi 0
dist_results <- map_dfr(subclusters, function(cl) {
  sub <- subset(SCT, reassigned_clusters == cl)
  # Aggregate (sum) counts per dpi
  pb_cl <- AggregateExpression(sub, group.by = "dpi", return.seurat = TRUE,
                               assays = "SCT", verbose = FALSE)
  # Use scale.data for PCA
  mat <- GetAssayData(pb_cl, assay = "SCT", layer = "scale.data")
  # Need at least 2 dpi to run PCA
  if (ncol(mat) < 2) return(NULL)
  pca <- prcomp(t(mat), scale. = FALSE, center = TRUE)
  pc_df <- as.data.frame(pca$x) |>
    rownames_to_column("sample") |>
    mutate(dpi = str_remove(sample, "^g"))
  origin <- pc_df |> filter(dpi == "0") |> select(starts_with("PC")) |> as.numeric()
  pc_df |>
    rowwise() |>
    mutate(
      subcluster = cl,
      dist_from_0 = sqrt(sum((c_across(starts_with("PC")) - origin)^2))
    ) |>
    ungroup() |>
    select(subcluster, dpi, dist_from_0)
})

dist_results <- dist_results |>
  filter(dpi != "0") |>
  mutate(dpi = factor(dpi, levels = c("6", "30", "100")))

ggplot(dist_results, aes(x = dpi, y = dist_from_0, color = subcluster, group = subcluster)) +
  geom_line(linewidth = 0.8) +
  geom_point(size = 2.5) +
  labs(
    x = "Days post-infection",
    y = "Transcriptional distance from dpi 0\n(Euclidean distance in PC space)",
    color = "Subcluster",
    title = "Transcriptional dysregulation by subcluster"
  ) +
  theme_minimal(base_size = 12)
