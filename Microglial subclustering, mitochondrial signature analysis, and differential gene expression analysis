# Calculate homeostatic gene expression level statistic significance
DefaultAssay(SCT) <- "SCT"
df <- FetchData(SCT, vars = c("reassigned_clusters", "Sparc"))
colnames(df) <- c("cluster", "gene")
df$cluster <- as.factor(df$cluster)
comparisons <- list(c("IEG-enriched microglia", "Homeostatic microglia"),
                    c("Hspa1 microglia", "Homeostatic microglia"),
                    c("DAM-like microglia", "Homeostatic microglia"),
                    c("IFN-responsive microglia", "Homeostatic microglia"),
                    c("Ccl3/Ccl4 inflammatory microglia", "Homeostatic microglia"),
                    c("TIM-like microglia", "Homeostatic microglia"),
                    c("NIC-1", "Homeostatic microglia"), 
                    c("NIC-2", "Homeostatic microglia"))
stat_test <- df %>%
  wilcox_test(gene ~ cluster, comparisons = comparisons, paired = FALSE) %>%
  adjust_pvalue(method = "BH") %>%
  add_y_position()
VlnPlot(SCT, features = "Sparc") +
  stat_pvalue_manual(stat_test, label = "p.adj", tip.length = 0.01) +
  ylim(NA, 1.3 * max(FetchData(SCT, "Sparc")))

