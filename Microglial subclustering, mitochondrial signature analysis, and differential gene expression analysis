# Subset microglia
load("R_data/Ptprc_or_Itgam_0/final/decontx_clustering_res.0.6.RData")
subset <- subset(reassign, idents = "Microglia") # n = 15086
DimPlot(object = subset, reduction = "umap", label = TRUE, pt.size = 0.2, alpha = 0.5)

# Redo clustering
DefaultAssay(subset) <- "RNA"
subset[["SCT"]] <- NULL
columns_to_remove <- grep("SCT_snn_res", colnames(subset@meta.data), value = TRUE)
subset@meta.data <- subset@meta.data[, !colnames(subset@meta.data) %in% columns_to_remove]
subset_2 <- subset(subset, features=rownames(subset)[rowSums(subset@assays$RNA@counts > 0) >= 10])

# Run SCT
options(future.globals.maxSize = 4000 * 1024^2)
SCT <- SCTransform(subset_2, vst.flavor = "v2", vars.to.regress = c("S.Score", "G2M.Score", "mitoRatio"))
SCT <- RunPCA(object = SCT)
ElbowPlot(SCT, ndims = 50)
SCT <- FindNeighbors(object = SCT, dims = 1:40)
SCT <- FindClusters(object = SCT, resolution = 2)
SCT <- RunUMAP(object = SCT, dims = 1:40)
DimPlot(object = SCT, reduction = "umap", label = TRUE, pt.size = 0.2)
save(SCT, file = "R_data/Ptprc_or_Itgam_0/final/microglia/clustering_res.2.RData")

