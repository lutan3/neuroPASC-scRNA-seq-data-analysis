# Single-cell-level DEG analysis of total microglia using Seurat (based on the non-parametric Wilcoxon rank sum test)
Idents(neutro) <- "dpi"
d6 <- FindMarkers(neutro, ident.1 = "6", ident.2 = "0", verbose = FALSE)
deg6_1 <- d6 %>% filter(avg_log2FC >= 1, p_val_adj <= 0.01, pct.1 > 0.2)
deg6_2 <- d6 %>% filter(avg_log2FC <= -1, p_val_adj <= 0.01, pct.2 > 0.2)
deg6 <- rbind(deg6_1, deg6_2)
write.csv(deg6, "R_data/Ptprc_or_Itgam_0/final/neutrophils/neutro_6_seurat.csv")

d30 <- FindMarkers(neutro, ident.1 = "30", ident.2 = "0", verbose = FALSE)
