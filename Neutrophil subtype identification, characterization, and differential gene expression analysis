# Plot gProfiler results
gprofiler <- read_excel("R_data/Ptprc_or_Itgam_0/final/neutrophils/6_gProfiler.xlsx")
gprofiler <- gprofiler[gprofiler$source == "GO:BP", ]

selected_terms <- c("innate immune response", 
                    "response to virus",
                    "defense response to virus",
                    "immune system process",
                    "activation of innate immune response",
                    "response to cytokine",
                    "activation of immune response",
                    "cellular response to interferon-beta",
                    "interferon-mediated signaling pathway",
                    "pattern recognition receptor signaling pathway",
                    "negative regulation of viral process",
                    "type I interferon production",
                    "cellular response to type II interferon",
                    "regulation of inflammatory response",
                    "pyroptotic inflammatory response",
                    "regulation of interferon-alpha production",
                    "MDA-5 signaling pathway",
                    "inflammasome-mediated signaling pathway")
filtered_terms <- gprofiler %>% filter(term_name %in% selected_terms)
filtered_terms <- filtered_terms %>% mutate(gene_ratio = intersection_size / term_size)

ggplot(filtered_terms, aes(x = gene_ratio, 
                           y = reorder(term_name, gene_ratio), 
                           size = intersection_size, 
                           color = negative_log10_of_adjusted_p_value)) +
  geom_point() +
  scale_color_gradient(low = "blue", high = "red") +
  labs(x = "Gene Ratio", y = NULL, size = "Gene Count", color = "-log10(FDR)", title = "Selected GO:BP Pathways Enriched") +
  theme_minimal(base_size = 12) +
  theme(panel.grid.major.y = element_blank())

ggplot(filtered_terms, aes(x = reorder(term_name, negative_log10_of_adjusted_p_value), y = negative_log10_of_adjusted_p_value, fill = source)) +
  geom_bar(stat = "identity") +
  coord_flip() +
  labs(x = "Term", y = "-log10(FDR)") +
  theme_minimal()

