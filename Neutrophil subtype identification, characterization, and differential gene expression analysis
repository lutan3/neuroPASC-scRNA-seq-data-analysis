# Gene module score calculation

# Maturation
gene_module <- c("Retnlg", "Ccl6", "S100a6", "Clec4d", "Prr13", "Cebpb", "Slpi", "S100a11", "Btg1", 
                 "Cxcr2", "Fth1", "Grina", "Mmp8", "Fxyd5", "Msrb1", "H2-D1", "Anxa2", "Mmp9", "Ftl1",
                 "Map1lc3b", "Tmcc1", "Sat1", "Cyp4f18", "Junb", "Mxd1", "Stk17b", "Ypel3", "Selplg",
                 "Il1f9", "Dusp1", "Slc16a3", "Ccr1", "Rdh12", "Clec4e", "Arg2", "Cd300ld", "Amica1",
                 "Ctsd", "Gda", "Hacd4", "Timp2", "Fpr1", "Ifi27l2a", "Slc7a11", "Stfa2l1", "Il1b",
                 "Asprv1", "Cxcl2", "Gm5483", "Ifitm1")
neutro <- AddModuleScore(neutro, features = list(gene_module), name = "Maturation")
df <- FetchData(neutro, vars = c("seurat_clusters", "Maturation1"))
colnames(df) <- c("cluster", "score")
df$cluster <- as.factor(df$cluster)
comparisons <- list(c("18", "13"),
                    c("16", "13"),
                    c("18", "16"))
stat_test <- df %>%
  wilcox_test(score ~ cluster, comparisons = comparisons, paired = FALSE) %>%
  adjust_pvalue(method = "BH") %>%
  add_y_position()
VlnPlot(neutro, features = "Maturation1") +
  stat_pvalue_manual(stat_test, label = "p.adj", tip.length = 0.01) +
  ylim(NA, 1.2 * max(FetchData(neutro, "Maturation1")))

