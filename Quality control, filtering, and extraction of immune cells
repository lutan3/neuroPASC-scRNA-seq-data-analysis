library(SingleCellExperiment)
library(Seurat)
library(tidyverse)
library(Matrix)
library(scales)
library(cowplot)
library(RCurl)
library(dplyr)
library(celda)
library(ggpubr)

load("R_data/merged_seurat")

# Visualize the number of cells per sample
merged_seurat@meta.data %>% 
  ggplot(aes(x=sample_name, fill=sample_name)) + 
  geom_bar() +
  theme_classic() +
  theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust=1)) +
  theme(plot.title = element_text(hjust=0.5, face="bold")) +
  ggtitle("NCells")
cell_counts <- count(merged_seurat@meta.data, 'sample_name')

# Visualize the distribution of counts and features
Idents(merged_seurat) <- "dpi"
p <- VlnPlot(merged_seurat, features = "nCount_RNA")
p + coord_cartesian(ylim = c(800, 35000))
p <- VlnPlot(merged_seurat, features = "nFeature_RNA")
p + coord_cartesian(ylim = c(400, 8000))

# Visualize the correlation between features and counts per cell
merged_seurat@meta.data %>% 
  ggplot(aes(x=nCount_RNA, y=nFeature_RNA)) + 
  geom_point() + 
  scale_colour_gradient(low="gray90", high="black") +
  stat_smooth(method=lm) +
  stat_cor(method = "pearson", label.x.npc = "left", label.y.npc = "top") + 
  scale_x_log10() + 
  scale_y_log10() + 
  theme_classic() +
  geom_vline(xintercept = 500) +
  geom_hline(yintercept = 250) +
  facet_wrap(~sample_name)

# Add number of genes per UMI for each cell to metadata
merged_seurat$log10GenesPerUMI <- log10(merged_seurat$nFeature_RNA) / log10(merged_seurat$nCount_RNA) # This metric approximates library complexity or transcript diversity for each cell
VlnPlot(merged_seurat, features = "log10GenesPerUMI")

# Compute percent mitoRatio
merged_seurat$mitoRatio <- PercentageFeatureSet(object=merged_seurat, pattern="^mt-")
merged_seurat$mitoRatio <- merged_seurat@meta.data$mitoRatio / 100
VlnPlot(merged_seurat, features = "mitoRatio")

# Determine cell cycle phases
g2m_genes <- c("Ncapd2", "Anln", "Tacc3", "Hmmr", "Gtse1", "Ndc80", "Aurka",
               "Tpx2", "Birc5", "G2e3", "Cbx5", "Rangap1", "Ctcfr", "Cdca3",
               "Ttk", "Smc4", "Ect2", "Cenpa", "Cdc20", "Nek2", "Cenpf", "Tmpo",
               "Hjurp", "Cks2", "Dlgap5", "Pimreg", "Top2a", "Psrc1", "Cdca8",
               "Ckap2", "Nusap1", "Kif23", "Kif11", "Kif20b", "Cenpe", "Gas2l3",
               "Kif2c", "Nuf2", "Anp32e", "Lbr", "Mki67", "Ccnb2", "Cdc25c",
               "Hmgb2", "Ckap2l", "Bub1", "Cdk1", "Cks1b", "Ube2c", "Ckap5",
               "Aurkb", "Cdca2", "Tubb4b", "Jpt1")
s_genes <- c("Ubr7", "Rfc2", "Rad51", "Mcm2", "Tipin", "Mcm6", "Ung", "Pold3",
             "Wdr76", "Clspn", "Cdc45", "Cdc6", "Msh2", "Mcm5", "Pola1", "Mcm4",
             "Rad51ap1", "Gmnn", "Rpa2", "Casp8ap2", "Hells", "E2f8", "Gins2",
             "Pcna", "Nasp", "Brca1", "Dscc1", "Dtl", "Cdca7", "Cenpu", "Atad2",
             "Chaf1b", "Usp1", "Slbp", "Rrm1", "Fen1", "Rrm2", "Exo1", "Ccne2",
             "Tyms", "Blm", "Prim1","Uhrf1")
merged_seurat <- CellCycleScoring(merged_seurat, g2m.features = g2m_genes, s.features = s_genes)
VlnPlot(merged_seurat, features = "S.Score")
VlnPlot(merged_seurat, features = "G2M.Score")

# Filter out low quality cells using selected thresholds
filtered_seurat <- subset(x = merged_seurat, 
                          subset = (400 < nFeature_RNA) & (nFeature_RNA < 8000) &
                            (800 < nCount_RNA) & (nCount_RNA < 35000) &
                            (mitoRatio < 0.05) & 
                            (log10GenesPerUMI > 0.80)) # 25852 out of 28241 cells are kept

# Keep immune cells
cells_to_keep <- WhichCells(filtered_seurat, expression = Ptprc + Itgam > 0)
Ptprc_Itgam_0 <- subset(filtered_seurat, cells = cells_to_keep) # 21798 out of 25852 cells are kept

# Keep genes which are expressed in 10 or more cells
Ptprc_Itgam_0 <- subset(Ptprc_Itgam_0, features=rownames(Ptprc_Itgam_0)[
  rowSums(Ptprc_Itgam_0@assays$RNA@counts > 0) >= 10]) # 15323 out of 19062 cells are kept

# Save the filtered files
save(Ptprc_Itgam_0, file="R_Data/Ptprc_or_Itgam_0/Ptprc_Itgam_0_final.RData")

# Evaluate effects of cell cycle and mitochondrial expression
seurat_norm <- NormalizeData(Ptprc_Itgam_0)
seurat_norm <- FindVariableFeatures(seurat_norm, 
                                    selection.method = "vst",
                                    nfeatures = 2000, 
                                    verbose = FALSE)
seurat_norm <- ScaleData(seurat_norm)
seurat_norm <- RunPCA(seurat_norm)

# Plot PCA colored by cell cycle phase
DimPlot(seurat_norm, reduction = "pca", group.by= "Phase", split.by = "Phase")

# Turn mitoRatio into categorical factor vector based on quartile values
summary(seurat_norm@meta.data$mitoRatio)
seurat_norm@meta.data$mitoFr <- cut(seurat_norm@meta.data$mitoRatio, 
                                    breaks=c(0.000000, 0.001502, 0.003233, 0.006109, 0.049828), 
                                    labels=c("Low","Medium","Medium high", "High"))

# Plot PCA colored by mitochondrial expression levels
DimPlot(seurat_norm, reduction = "pca", group.by= "mitoFr", split.by = "mitoFr")

# Decide if integration is needed
seurat_norm <- RunUMAP(seurat_norm, dims = 1:40, reduction = "pca")
DimPlot(seurat_norm, group.by= "sample_name", split.by = "sample_name")
