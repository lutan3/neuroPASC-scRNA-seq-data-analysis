# Seurat DEG plot
Idents(BAMlo) <- "dpi"
custom_order <- c("0", "6", "30", "100")
Idents(BAMlo) <- factor(Idents(BAMlo), levels = custom_order)

df <- FetchData(BAMlo, vars = c("dpi", "Il18"))
colnames(df) <- c("dpi", "expr")
df$dpi <- as.factor(df$dpi)
comparisons <- list(c("6", "0"), c("30", "0"), c("100", "0"))
stat_test <- df %>%
  wilcox_test(expr ~ dpi, comparisons = comparisons, paired = FALSE) %>%
  adjust_pvalue(method = "BH") %>%
  add_y_position() 
VlnPlot(BAMlo, features = "Il18") +
  stat_pvalue_manual(stat_test, label = "p.adj", tip.length = 0.01) +
  ylim(NA, 1.4 * max(FetchData(BAMlo, "Il18")))

