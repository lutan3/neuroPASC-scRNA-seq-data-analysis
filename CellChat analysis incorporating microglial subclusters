prep_cellchat <- function(reassign.list, species = "mouse",
                          group.by = "combined_clusters", 
                          min.cells = 20,
                          min.cells.per.gene = 20) {
  species <- match.arg(species)
  counts <- GetAssayData(reassign.list, assay = "RNA", slot = "counts")
  keep_genes <- rowSums(counts > 0) >= min.cells.per.gene
  data.input <- GetAssayData(reassign.list, assay = "RNA", slot = "data")[keep_genes, ]
  meta <- reassign.list@meta.data
  cellchat <- createCellChat(object = data.input, meta = meta, group.by = group.by)
  CellChatDB <- switch(species, mouse = CellChatDB.mouse)
  cellchat@DB <- CellChatDB
  cellchat <- subsetData(cellchat)
  cellchat <- identifyOverExpressedGenes(cellchat)
  cellchat <- identifyOverExpressedInteractions(cellchat)
  cellchat <- computeCommunProb(cellchat, population.size = TRUE)
  cellchat <- filterCommunication(cellchat, min.cells = min.cells)
  cellchat <- computeCommunProbPathway(cellchat)
  cellchat <- aggregateNet(cellchat)
  cellchat <- netAnalysis_computeCentrality(cellchat, slot.name = "netP")
  return(cellchat)
}

cond_names <- names(reassign.list)
cellchat.list.2 <- lapply(cond_names, function(nm) {
