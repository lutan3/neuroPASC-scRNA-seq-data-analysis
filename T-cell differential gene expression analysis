# CD8 T cells
Idents(subset) <- "subtype"
CD8 <- subset(subset, idents = "CD8+")
Idents(CD8) <- "dpi"

# Exaustion marker genes Pdcd1, Cd38, Eomes, Tigit, Entpd1, Ctla4, Tox
# Other markers H2-Aa, H2-Ab1, Mki67, Gzmb, Havcr2
df <- FetchData(CD8, vars = c("dpi", "Cd38"))
colnames(df) <- c("dpi", "gene")
df$dpi <- as.factor(df$dpi)
comparisons <- list(c("6", "0"), c("30", "0"), c("100", "0"))
stat_test <- df %>%
  wilcox_test(gene ~ dpi, comparisons = comparisons, paired = FALSE) %>%
  adjust_pvalue(method = "BH") %>%
  add_y_position() 
VlnPlot(CD8, features = "Cd38") +
  stat_pvalue_manual(stat_test, label = "p.adj", tip.length = 0.01) +
  ylim(NA, 1.2 * max(FetchData(CD8, "Cd38")))

# Single-cell-level DEG analysis using Seurat
Idents(subset) <- "dpi"
d6 <- FindMarkers(subset, ident.1 = "6", ident.2 = "0", verbose = FALSE)
deg6_1 <- d6 %>% filter(avg_log2FC >= 1, p_val_adj <= 0.01, pct.1 > 0.2)
deg6_2 <- d6 %>% filter(avg_log2FC <= -1, p_val_adj <= 0.01, pct.2 > 0.2)
deg6 <- rbind(deg6_1, deg6_2)
write.csv(deg6, "R_data/Ptprc_or_Itgam_0/final/T.cells/6_seurat.csv")

