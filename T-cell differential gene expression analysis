# T cell subtypes based on CD4 and CD8 expression
subset$subtype <- "Unassigned"
raw_counts <- subset@assays$RNA@counts
subset$subtype[raw_counts["Cd4", ] > 0 & raw_counts["Cd8a", ] == 0] <- "CD4+"
subset$subtype[raw_counts["Cd8a", ] > 0 & raw_counts["Cd4", ] == 0] <- "CD8+"
subset$subtype[raw_counts["Cd4", ] > 0 & raw_counts["Cd8a", ] > 0] <- "DP"
# Visualize the split
DimPlot(subset, group.by = "subtype", label = TRUE)

# Count in each subtype by time points (sample names)
